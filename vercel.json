{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ask.py": {
      "maxDuration": 60,
      "includeFiles": "api/_*.py"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
